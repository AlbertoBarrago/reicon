#!/bin/zsh
# reicon: set, restore and keep custom icons on macOS apps.
#
# Uses NSWorkspace.setIcon through JavaScript for Automation (osascript), so it
# needs no Xcode, Command Line Tools or third-party dependency. This is the same
# mechanism Finder uses when you paste an image into "Get Info": it writes an
# "Icon\r" file inside the bundle and sets the custom-icon Finder flag.
#
# An app update replaces the bundle and drops that file. `reicon set` keeps a
# copy of each image in the registry so `reicon sync` can put the icons back.

set -euo pipefail

readonly PROG=reicon
readonly VERSION=0.1.0
readonly ICON_FILE=$'Icon\r'
# Inside functions $0 is the function name: resolve the script path once here.
readonly SELF=${0:A}
readonly APP_MANAGEMENT_URL='x-apple.systempreferences:com.apple.preference.security?Privacy_AppBundles'

# Under sudo, $HOME may be root's: always work on the invoking user's home.
if [[ -n ${SUDO_USER-} ]]; then
  readonly USER_HOME=${userdirs[$SUDO_USER]}
else
  readonly USER_HOME=$HOME
fi

readonly APP_DIRS=(/Applications "$USER_HOME/Applications")
readonly CONFIG_DIR=${XDG_CONFIG_HOME:-$USER_HOME/.config}/reicon
readonly ICONS_DIR=$CONFIG_DIR/icons
# One line per managed app: "<app path>\t<stored image path>".
readonly REGISTRY=$CONFIG_DIR/registry.tsv

# --- help -------------------------------------------------------------------

usage() {
  cat <<EOF
reicon $VERSION: custom icons for macOS apps

Usage:
  $PROG set <app> <image>    set <image> (png, jpg, icns, svg) as the icon of <app>
  $PROG restore <app>        remove the custom icon and restore the original one
  $PROG list                 show managed icons and other apps with a custom icon
  $PROG sync                 re-apply managed icons dropped by app updates
  $PROG help [command]       show help, or help for one command
  $PROG --version            show the version

<app> is a path to a .app bundle or just its name (OpenIDEA, "Visual Studio Code"),
looked up in /Applications and ~/Applications.
Apps not owned by you (App Store, installers, other users) need sudo.

Examples:
  $PROG set OpenIDEA ~/Downloads/openidea.png
  $PROG sync
EOF
}

usage_set() {
  cat <<EOF
Usage: $PROG set <app> <image>

Sets <image> as the icon of <app>, refreshes Finder and the Dock, and stores a
copy of the image so '$PROG sync' can re-apply it after the app updates.
Use a square image, ideally 1024x1024 with the macOS icon shape already drawn.
Apps not owned by you (App Store, installers, other users) need sudo.
EOF
}

usage_restore() {
  cat <<EOF
Usage: $PROG restore <app>

Removes the custom icon of <app> and forgets it, so '$PROG sync' leaves it alone.
EOF
}

usage_list() {
  cat <<EOF
Usage: $PROG list

Shows the icons managed by $PROG with their state:
  ok            the custom icon is in place
  needs sync    the app was updated and lost its icon: run '$PROG sync'
  app missing   the app is no longer installed
and the apps in ${APP_DIRS[*]} with a custom icon set outside $PROG.
EOF
}

usage_sync() {
  cat <<EOF
Usage: $PROG sync

Re-applies every managed icon that is no longer in place, typically after an
app update. Apps that are no longer installed are skipped.
EOF
}

# --- helpers ----------------------------------------------------------------

warn() {
  print -ru2 -- "$PROG: $*"
}

die() {
  warn "$@"
  exit 1
}

# Creates the config dirs as the invoking user, so sudo never leaves a
# root-owned ~/.config behind.
ensure_config_dirs() {
  if [[ -n ${SUDO_USER-} ]]; then
    sudo -u "$SUDO_USER" mkdir -p "$ICONS_DIR"
  else
    mkdir -p "$ICONS_DIR"
  fi
}

# Files written under sudo would otherwise belong to root.
fix_owner() {
  [[ -n ${SUDO_USER-} && -e $CONFIG_DIR ]] && chown -R "$SUDO_USER" "$CONFIG_DIR"
  return 0
}

# Accepts a bundle path or a bare app name and prints the canonical bundle path.
# Canonical (:A) matters: APFS is case-insensitive, and the path is the registry key.
resolve_app() {
  local arg=$1
  if [[ $arg == */* || $arg == *.app ]] && [[ -d $arg ]]; then
    [[ ${arg:A} == *.app ]] || die "not an app bundle: $arg"
    print -r -- ${arg:A}
    return
  fi
  local name=${arg%.app} dir
  for dir in $APP_DIRS; do
    [[ -d $dir/$name.app ]] && { print -r -- ${${:-$dir/$name.app}:A}; return; }
  done
  die "app not found in ${APP_DIRS[*]}: $arg"
}

# Prints why <app> cannot be changed and returns non-zero, or returns 0.
# Return codes: 1 = never changeable (system app), 2 = changeable with sudo.
check_writable() {
  local app=$1
  if [[ $app == /System/* ]]; then
    warn "system apps live on a read-only volume and cannot be changed: $app"
    return 1
  fi
  if [[ ! -w $app ]]; then
    warn "no write access to $app (owned by $(stat -f %Su "$app"))."
    return 2
  fi
  return 0
}

# Prints the current command line prefixed with sudo, quoted so it can be pasted
# as is. Uses the bare name only when it resolves to this script on the PATH.
sudo_command() {
  local cmd=$SELF
  [[ ${commands[$PROG]:A} == "$cmd" ]] && cmd=$PROG
  print -r -- "sudo ${(q-)cmd} ${(j: :)${(q-)ORIG_ARGS[@]}}"
}

# Explains that sudo is needed and shows the exact command to run. Many users
# never read the README, so in an interactive terminal it also offers to re-run
# the command with sudo right away; scripts and pipes only get the hint.
offer_sudo() {
  warn "apps not owned by you (App Store, installers, other users) need admin rights. Run:"
  print -lru2 -- "" "    $(sudo_command)" ""
  (( EUID != 0 )) && [[ -t 0 && -t 2 ]] || return 0
  local answer
  read -r "answer?Run it now with sudo? [y/N] " || return 0
  # Absolute path: sudo may reset PATH and lose ~/.local/bin.
  [[ $answer == [yY]* ]] && exec sudo -- "$SELF" "${ORIG_ARGS[@]}"
  return 0
}

# Exits unless <app> can be changed, offering sudo when that would fix it.
require_writable() {
  local rc=0
  check_writable "$1" || rc=$?
  (( rc == 0 )) && return 0
  (( rc == 2 )) && offer_sudo
  exit 1
}

has_custom_icon() {
  [[ -e $1/$ICON_FILE ]]
}

# Calls NSWorkspace.setIcon(_:forFile:options:). An empty image path clears the
# custom icon. Throwing inside JXA makes osascript exit non-zero; its message is
# printed without the "execution error: Error:" prefix and "(-2700)" code it adds.
# Returns 0 on success, 1 on error, 3 when macOS blocked the write (App Management).
apply_icon() {
  local app=$1 image=$2 out
  out=$(osascript -l JavaScript - "$app" "$image" 2>&1 <<'JXA'
ObjC.import('AppKit');
function run(argv) {
  const [app, imagePath] = argv;
  let image = $();
  if (imagePath) {
    image = $.NSImage.alloc.initWithContentsOfFile(imagePath);
    if (image.isNil()) throw new Error('cannot read image: ' + imagePath);
  }
  return $.NSWorkspace.sharedWorkspace.setIconForFileOptions(image, app, 0) ? 'ok' : 'refused';
}
JXA
  ) || {
    warn "$(print -r -- "$out" | sed -E 's/^execution error: (Error: )*//; s/ \(-?[0-9]+\)$//')"
    return 1
  }
  [[ $out == ok ]] || return 3
  # setIcon can report success without touching a protected bundle: trust the
  # file on disk, not the return value.
  if [[ -n $image ]]; then
    has_custom_icon "$app" || return 3
  else
    ! has_custom_icon "$app" || return 3
  fi
  return 0
}

# Prints the terminal app that needs App Management. TERM_PROGRAM is the only
# portable hint (sudo usually drops it, hence the generic fallback).
terminal_name() {
  case ${TERM_PROGRAM-} in
    "") print -r -- "your terminal" ;;
    Apple_Terminal) print -r -- '"Terminal"' ;;
    *) print -r -- "\"${TERM_PROGRAM%.app}\"" ;;
  esac
}

# App Management is a TCC permission checked on the terminal hosting reicon,
# even for root: sudo cannot replace it. Explains that and, in an interactive
# terminal, offers to open the right Settings pane.
offer_app_management() {
  warn "macOS blocked the change to $1."
  warn "allow $(terminal_name) in System Settings > Privacy & Security > App Management,"
  warn "then quit and reopen it. sudo does not bypass this."
  [[ -t 0 && -t 2 ]] || return 0
  local answer
  read -r "answer?Open the settings now? [y/N] " || return 0
  [[ $answer == [yY]* ]] || return 0
  # Under sudo, open as the invoking user: root has no GUI session to show it in.
  if [[ -n ${SUDO_USER-} ]]; then
    sudo -u "$SUDO_USER" open "$APP_MANAGEMENT_URL"
  else
    open "$APP_MANAGEMENT_URL"
  fi
}

# Applies <image> to <app> or exits, guiding the user when macOS blocked it.
require_applied() {
  local rc=0
  apply_icon "$1" "$2" || rc=$?
  (( rc == 0 )) && return 0
  (( rc == 3 )) && offer_app_management "$1"
  exit 1
}

# Finder caches icons per bundle: bumping the mtime invalidates that cache.
touch_app() {
  touch "$1"
}

# The Dock keeps its own icon cache, reloaded only on restart. A failed restart
# is not fatal (the icon is already set), but it leaves the Dock showing the
# old icon, so say so instead of failing silently.
refresh_dock() {
  killall Dock 2>/dev/null && return 0
  warn "could not restart the Dock, it may keep showing the old icon. Run: killall Dock"
}

bundle_id() {
  /usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null \
    || print -r -- ${1:t:r}
}

# Prints the registry without the line for <app>.
registry_without() {
  [[ -f $REGISTRY ]] || return 0
  awk -F'\t' -v app="$1" '$1 != app' "$REGISTRY"
}

registry_image() {
  [[ -f $REGISTRY ]] || return 0
  awk -F'\t' -v app="$1" '$1 == app { print $2; exit }' "$REGISTRY"
}

# Atomic rewrite, so an interrupted run never leaves a half-written registry.
registry_write() {
  local content=$1 tmp
  ensure_config_dirs
  tmp=$(mktemp "$CONFIG_DIR/registry.XXXXXX")
  [[ -n $content ]] && print -r -- "$content" >"$tmp"
  mv "$tmp" "$REGISTRY"
}

# --- commands ---------------------------------------------------------------

cmd_set() {
  (( $# == 2 )) || { usage_set >&2; exit 1; }
  local app image stored previous
  app=$(resolve_app "$1")
  image=${2:A}
  [[ -f $image ]] || die "image not found: $2"
  require_writable "$app"

  require_applied "$app" "$image"
  touch_app "$app"
  refresh_dock

  ensure_config_dirs
  stored=$ICONS_DIR/$(bundle_id "$app").${image:e:l}
  # The previous copy may have another extension: drop it before storing the new one.
  previous=$(registry_image "$app")
  [[ -n $previous && $previous != "$stored" ]] && rm -f "$previous"
  [[ $image != "$stored" ]] && cp "$image" "$stored"
  registry_write "$(registry_without "$app"; print -r -- "$app"$'\t'"$stored")"
  fix_owner

  print -r -- "Set ${image:t} as the icon of ${app:t}"
}

cmd_restore() {
  (( $# == 1 )) || { usage_restore >&2; exit 1; }
  local app previous
  app=$(resolve_app "$1")
  require_writable "$app"

  require_applied "$app" ""
  touch_app "$app"
  refresh_dock

  previous=$(registry_image "$app")
  if [[ -n $previous ]]; then
    rm -f "$previous"
    registry_write "$(registry_without "$app")"
    fix_owner
  fi

  print -r -- "Restored the original icon of ${app:t}"
}

cmd_list() {
  (( $# == 0 )) || { usage_list >&2; exit 1; }
  local -A managed
  local app image state

  if [[ -s $REGISTRY ]]; then
    print -- "Managed by $PROG:"
    while IFS=$'\t' read -r app image; do
      managed[$app]=1
      if [[ ! -d $app ]]; then state="app missing"
      elif has_custom_icon "$app"; then state="ok"
      else state="needs sync"
      fi
      printf '  %-12s %s\n' "$state" "$app"
      # Older entries may differ in case from the real path: match both forms.
      managed[${app:A}]=1
    done <"$REGISTRY"
  else
    print -- "No icons managed by $PROG yet."
  fi

  local -a others=()
  for app in ${^APP_DIRS}/*.app(N); do
    (( ${+managed[$app]} )) && continue
    has_custom_icon "$app" && others+=("$app")
  done
  if (( ${#others} )); then
    print -- "\nCustom icon set outside $PROG:"
    printf '  %s\n' "${others[@]}"
  fi
  return 0
}

cmd_sync() {
  (( $# == 0 )) || { usage_sync >&2; exit 1; }
  [[ -s $REGISTRY ]] || { print -- "No icons managed by $PROG yet."; return; }

  # One failing app must not stop the others: count it and exit non-zero at the end.
  local app image rc applied=0 skipped=0 failed=0 needs_sudo=0 blocked=0
  while IFS=$'\t' read -r app image; do
    if [[ ! -d $app ]]; then
      print -r -- "skip      $app (not installed)"
      (( skipped += 1 ))
    elif has_custom_icon "$app"; then
      print -r -- "ok        $app"
    elif [[ ! -f $image ]]; then
      print -ru2 -- "failed    $app (stored image $image is gone, run '$PROG set' again)"
      (( failed += 1 ))
    else
      rc=0
      check_writable "$app" || rc=$?
      (( rc == 0 )) && { apply_icon "$app" "$image" || rc=$?; }
      if (( rc == 0 )); then
        touch_app "$app"
        print -r -- "applied   $app"
        (( applied += 1 ))
      else
        (( rc == 2 )) && needs_sudo=1
        (( rc == 3 )) && blocked=1
        print -ru2 -- "failed    $app"
        (( failed += 1 ))
      fi
    fi
  done <"$REGISTRY"

  (( applied )) && refresh_dock
  print -- "\n$applied applied, $skipped skipped, $failed failed"
  # No prompt here: sync often runs unattended, and one hint covers every app.
  if (( needs_sudo )); then
    warn "some apps are not owned by you and need admin rights. Run:"
    print -lru2 -- "" "    $(sudo_command)"
  fi
  if (( blocked )); then
    warn "macOS blocked some changes: allow $(terminal_name) in System Settings >"
    warn "Privacy & Security > App Management, then quit and reopen it. sudo does not bypass this."
  fi
  (( failed == 0 ))
}

cmd_help() {
  case ${1-} in
    "") usage ;;
    set|restore|list|sync) usage_$1 ;;
    *) die "unknown command: $1" ;;
  esac
}

main() {
  local cmd=${1-}
  (( $# )) && shift
  case $cmd in
    set|restore|list|sync|help) cmd_$cmd "$@" ;;
    -h|--help) usage ;;
    -v|--version) print -- "$PROG $VERSION" ;;
    "") usage >&2; exit 1 ;;
    *) print -u2 -- "$PROG: unknown command: $cmd"; usage >&2; exit 1 ;;
  esac
}

# Kept for offer_sudo/sudo_command, which rebuild the command line.
typeset -ra ORIG_ARGS=("$@")

main "$@"
